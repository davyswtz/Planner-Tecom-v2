# ── Hostinger — copie para .env na raiz do Laravel (pasta planner/) ──
# Preencha apenas APP_URL e DB_PASSWORD (o resto já vem pronto para seu banco).

APP_NAME=Planner
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://planner.seudominio.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_LEVEL=warning

# MySQL — no servidor Hostinger use localhost
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=samu6922_burrinhosProjetosProd
DB_USERNAME=samu6922_davypandrade
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

# Tempo real: use "log" até configurar Pusher (app funciona sem sync entre abas)
# Depois troque para pusher e preencha PUSHER_* — veja deploy/INSTALAR-HOSTINGER.md
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Pusher (opcional — descomente quando tiver conta em dashboard.pusher.com)
# BROADCAST_CONNECTION=pusher
# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_APP_CLUSTER=sa1
# VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
# VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
