# ── .env para rodar com Docker (copie para .env na raiz do projeto) ─────────
# No servidor da empresa: ajuste APP_URL, DB_* e segredos das APIs.

APP_NAME=Planner
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_LEVEL=warning

# ── Banco ────────────────────────────────────────────────────────────────────
# Opção A — MySQL externo (servidor da empresa):
DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=planner
DB_USERNAME=planner
DB_PASSWORD=

# Opção B — MySQL no Docker (profile with-db):
# DB_HOST=db
# DB_ROOT_PASSWORD=root
# docker compose --profile with-db up -d

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Porta exposta pelo nginx no host
APP_PORT=8080

# Rodar migrations na subida do container (primeiro deploy: true)
RUN_MIGRATIONS=false

# URL pública para anexos no Google Chat
PLANNER_PUBLIC_URL=
PLANNER_ANEXOS_CHAT_TTL_HORAS=72

VITE_APP_NAME="${APP_NAME}"

# Nicon API
NICON_BASE_URL=https://nicon.ibitelecom.com.br
NICON_EMAIL=
NICON_PASSWORD=
NICON_TIMEOUT=120
# Chat Nicon em paralelo ao webhook Google Chat (não substitui)
# NICON_CHAT_ENABLED=true
# NICON_CHAT_CONVERSA_ID=4180
# NICON_CHAT_CONVERSAS={"Goval":4180,"Vale do Aço":4180}

# GeoGrid
GEOGRID_BASE_URL=https://eros.geogridmaps.com.br/nicnettele
GEOGRID_USER=
GEOGRID_PASSWORD=
GEOGRID_VERSION=199.5
GEOGRID_TIMEOUT=120
GEOGRID_PASTA_CAIXAS=1713
GEOGRID_CAIXAS_CACHE_MINUTES=360
