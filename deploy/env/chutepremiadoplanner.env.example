# ── Deploy: chutepremiadoplanner.chutepremiado.com ──
#
# ⚠️  NÃO substitua o .env inteiro do servidor por este arquivo!
#     Isso apaga APP_KEY e DB_PASSWORD e derruba o site.
#
# Em produção já rodando, adicione APENAS estas linhas ao .env existente:
#
#   PLANNER_PUBLIC_URL=https://chutepremiadoplanner.chutepremiado.com
#   PLANNER_ANEXOS_CHAT_TTL_HORAS=72
#
# Depois: php artisan config:clear && php artisan config:cache
#
# Use este arquivo completo só em instalação NOVA (primeiro deploy).

APP_NAME=Planner
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://chutepremiadoplanner.chutepremiado.com
PLANNER_PUBLIC_URL=https://chutepremiadoplanner.chutepremiado.com
PLANNER_ANEXOS_CHAT_TTL_HORAS=72

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=samu6922_burrinhosProjetosProd
DB_USERNAME=samu6922_davypandrade
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Pusher (opcional — só se tiver conta em dashboard.pusher.com)
# BROADCAST_CONNECTION=pusher
# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_APP_CLUSTER=sa1

VITE_APP_NAME="${APP_NAME}"
