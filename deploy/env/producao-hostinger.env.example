# ── .env para o SERVIDOR Hostinger (chutepremiadoplanner.chutepremiado.com) ──
# Cole em ~/planner/.env — NÃO use o .env do seu PC diretamente.

APP_NAME=Planner
APP_ENV=production
APP_KEY=base64:COLE_SUA_APP_KEY_AQUI
APP_DEBUG=false
APP_URL=https://chutepremiadoplanner.chutepremiado.com

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_LEVEL=warning

# MySQL — no servidor Hostinger SEMPRE use localhost
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=samu6922_burrinhosProjetosProd
DB_USERNAME=samu6922_davypandrade
DB_PASSWORD="sua_senha_mysql"

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

VITE_APP_NAME="${APP_NAME}"

# Nicon API
NICON_BASE_URL=https://nicon.ibitelecom.com.br
NICON_EMAIL=seu_usuario
NICON_PASSWORD="sua_senha"
NICON_TIMEOUT=120
# Chat Nicon em paralelo ao webhook Google Chat (não substitui)
# NICON_CHAT_ENABLED=false
# NICON_CHAT_CONVERSA_ID=0
# NICON_CHAT_CONVERSAS={"Goval":4180,"Vale do Aço":4180}

# GeoGrid
GEOGRID_BASE_URL=https://eros.geogridmaps.com.br/nicnettele
GEOGRID_USER=seu_usuario
GEOGRID_PASSWORD=sua_senha
GEOGRID_VERSION=199.5
GEOGRID_TIMEOUT=120
GEOGRID_PASTA_CAIXAS=1713
GEOGRID_CAIXAS_CACHE_MINUTES=360
