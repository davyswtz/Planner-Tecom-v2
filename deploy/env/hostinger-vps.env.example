# Hostinger VPS — copie para .env em produção
# Domínio: https://planner.seudominio.com.br

APP_NAME=Planner
APP_ENV=production
APP_DEBUG=false
APP_URL=https://planner.seudominio.com.br

DB_CONNECTION=mysql
DB_HOST=localhost
DB_DATABASE=u123456789_planner
DB_USERNAME=u123456789
DB_PASSWORD=

BROADCAST_CONNECTION=reverb
QUEUE_CONNECTION=sync

REVERB_APP_ID=planner-prod
REVERB_APP_KEY=gere-uma-chave-aleatoria-longa
REVERB_APP_SECRET=gere-outro-secret-aleatorio
REVERB_HOST=planner.seudominio.com.br
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
